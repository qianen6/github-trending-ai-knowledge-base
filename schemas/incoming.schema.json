{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.github-trending-radar/schemas/incoming.schema.json",
  "title": "GitHub Trending Daily Evidence Batch",
  "type": "object",
  "required": ["schema_version", "capture_date", "captured_at", "candidate_pool", "pages", "repositories"],
  "properties": {
    "schema_version": { "const": 4 },
    "capture_date": { "type": "string", "format": "date" },
    "captured_at": { "type": "string", "format": "date-time" },
    "candidate_pool": {
      "type": "object",
      "required": ["description", "dedupe_key", "raw_candidate_count", "evaluated_candidate_count"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "dedupe_key": { "const": "full_name" },
        "raw_candidate_count": { "type": "integer", "minimum": 1 },
        "evaluated_candidate_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/page" }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["scope", "period", "spoken_language", "source_url", "captured_at", "raw_sha256", "status", "entries"],
      "properties": {
        "scope": { "enum": ["global", "python", "typescript", "javascript", "jupyter-notebook", "go", "rust"] },
        "period": { "enum": ["daily", "weekly", "monthly"] },
        "spoken_language": { "const": "any" },
        "source_url": { "type": "string", "format": "uri" },
        "captured_at": { "type": "string", "format": "date-time" },
        "raw_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "status": { "enum": ["success", "failed"] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/trending_entry" } }
      },
      "additionalProperties": false
    },
    "trending_entry": {
      "type": "object",
      "required": ["rank", "full_name", "url", "description", "primary_language", "total_stars", "total_forks", "period_stars", "built_by"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "full_name": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "primary_language": { "type": ["string", "null"] },
        "total_stars": { "type": "integer", "minimum": 0 },
        "total_forks": { "type": "integer", "minimum": 0 },
        "period_stars": { "type": ["integer", "null"], "minimum": 0 },
        "built_by": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["full_name", "url", "description", "category", "created_at", "pushed_at", "is_fork", "is_mirror", "archived", "language", "hard_filter", "license", "quality", "value", "card", "evidence_urls"],
      "properties": {
        "full_name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "pushed_at": { "type": "string", "format": "date-time" },
        "is_fork": { "type": "boolean" },
        "is_mirror": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "language": { "type": ["string", "null"] },
        "hard_filter": { "type": "object" },
        "license": {
          "type": "object",
          "required": ["name", "scope_zh", "evidence_urls"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "scope_zh": { "type": "string", "minLength": 1 },
            "evidence_urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
          },
          "additionalProperties": false
        },
        "quality": { "type": "object" },
        "value": { "type": "object" },
        "card": {
          "type": "object",
          "required": ["one_line", "what", "audience", "usage", "features", "why", "strengths", "limitations", "value"],
          "properties": {
            "one_line": { "type": "string", "minLength": 1 },
            "what": { "type": "string", "minLength": 1 },
            "audience": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "usage": { "type": "string", "minLength": 1 },
            "features": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "why": { "type": "string", "minLength": 1 },
            "strengths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "evidence_urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "additionalProperties": false
    }
  }
}
